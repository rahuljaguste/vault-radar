# The Graph
GRAPH_STUDIO_API_KEY=
# Substreams sink database (Neon)
DATABASE_URL=
# Chain heads for freshness
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
# Optional: chain head RPC for any other chain in the standardized-deployments registry
# (42161, 10, 137, ...) — without one, that chain's sources are always reported stale.
# RPC_URL_42161=
# Service
PORT=8787
PUBLIC_URL=http://localhost:8787
PQ_SIG_SEED=            # 32 bytes hex: openssl rand -hex 32
PQ_KEM_SEED=            # 64 bytes hex: openssl rand -hex 64
# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_PAYTO_ACCOUNT_ID=0.0.xxxxx
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=            # ECDSA private key hex (DER or raw)
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_USDC_TOKEN=0.0.429274
HEDERA_HCS_TOPIC_ID=
# Arc testnet
ARC_SELLER_ADDRESS=0x...
ARC_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# ERC-8004 (filled by scripts/identity.ts)
ERC8004_HEDERA_AGENT_ID=
ERC8004_ARC_AGENT_ID=
# Agent (packages/agent)
SERVICE_URL=http://localhost:8787   # VaultRadar service the agent buys from
ANTHROPIC_API_KEY=              # required by `bun run agent chat`; `watch` needs no model
AGENT_HEDERA_ACCOUNT_ID=        # agent's own payer account, e.g. 0.0.12345
AGENT_HEDERA_KEY=               # ECDSA private key for that account
AGENT_ARC_KEY=                  # Arc (Circle Gateway) private key, 0x-prefixed 32 bytes
POLICY_PATH=packages/agent/policy.example.json
RUNS_DIR=runs
