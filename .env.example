# The Graph
GRAPH_STUDIO_API_KEY=
SUBSTREAMS_API_TOKEN=           # thegraph.market token; read by substreams-sink-sql, not by any TS here
# Substreams sink database (Neon)
DATABASE_URL=
# Chain heads for freshness
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
# Optional: chain head RPC for any other chain in the standardized-deployments registry
# (42161, 10, 137, ...) — without one, that chain's sources are always reported stale.
# RPC_URL_42161=
# RPC_URL_10=
# RPC_URL_137=
# Service
PORT=8787
PUBLIC_URL=http://localhost:8787
PQ_SIG_SEED=            # 32 bytes hex: openssl rand -hex 32
PQ_KEM_SEED=            # 64 bytes hex: openssl rand -hex 64
# Hedera testnet
HEDERA_NETWORK=testnet
HEDERA_PAYTO_ACCOUNT_ID=0.0.xxxxx
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=            # ECDSA private key hex (DER or raw)
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_USDC_TOKEN=0.0.429274
HEDERA_HCS_TOPIC_ID=
# Arc testnet
ARC_SELLER_ADDRESS=0x...
ARC_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Operator metrics: gates GET /v1/admin/metrics on the service and the dashboard's
# /admin page. Both processes need the same value. Server-side only, never sent to a browser.
ADMIN_TOKEN=                    # openssl rand -hex 32; unset means no /admin view
# ERC-8004 (filled by scripts/identity.ts)
ERC8004_HEDERA_AGENT_ID=
ERC8004_ARC_AGENT_ID=
DEPLOYER_KEY_HEDERA=            # 0x-prefixed EVM key with an alias; identity.ts only, not for --dry-run
DEPLOYER_KEY_ARC=               # same, on Arc
# Agent (packages/agent)
SERVICE_URL=http://localhost:8787   # VaultRadar service the agent buys from
ANTHROPIC_API_KEY=              # required by `bun run agent chat`; `watch` needs no model
AGENT_HEDERA_ACCOUNT_ID=        # agent's own payer account, e.g. 0.0.12345
AGENT_HEDERA_KEY=               # ECDSA private key for that account
AGENT_ARC_KEY=                  # Arc (Circle Gateway) private key, 0x-prefixed 32 bytes
POLICY_PATH=packages/agent/policy.example.json
RUNS_DIR=runs
VAULT=1:0x0000000000000000000000000000000000000000   # one vault id for the hello-x402 script
DEPOSIT=                        # USDC to deposit into Gateway before paying, in hello-arc (designed)
# Dashboard (packages/dashboard). Also reads SERVICE_URL, POLICY_PATH, RUNS_DIR,
# ADMIN_TOKEN and the AGENT_HEDERA_* pair above: /portfolio buys with the operator's
# agent account, never a visitor's wallet, and those keys never leave the server.
NEXT_PUBLIC_SERVICE_URL=http://localhost:8787   # /verify needs it inlined at build time
DEMO=                           # advisory; public/demo-run.json is served only when RUNS_DIR holds no runs
# Aggregate limits on POST /api/scan, applied across every caller before each payment. The
# agent policy budget and the per-scan ceiling cap one purchase; these cap the bill.
DASHBOARD_SPEND_CAP_USD=1.00    # rolling 24 h total; a scan that would cross it is refused
DASHBOARD_MAX_SCANS_PER_HOUR=20 # global hourly scan allowance
SCAN_ACCESS_TOKEN=              # set to require `Authorization: Bearer <token>` on POST /api/scan (401 otherwise)
TRUST_PROXY=                    # TRUST_PROXY=1 only behind a proxy that sets x-forwarded-for;
                                # otherwise the per-client rate limit keys everyone together,
                                # because those headers are forgeable by a direct caller
# Tests and tooling
LIVE=                           # LIVE=1 un-skips the live-testnet tests, which spend real testnet USDC
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome   # scripts/render-diagrams.mjs
# DIAGRAM_SCALE=1               # 2 renders the mermaid PNGs at retina resolution
