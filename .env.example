# VaultRadar environment.
#
# Copy to .env and fill in. Only PQ_SIG_SEED and PQ_KEM_SEED are hard requirements:
# the service refuses to boot without them. Everything else has a default or degrades
# to a clearly-reported "unavailable" rather than failing silently.
#
# Grouped by who reads the variable. A variable marked (designed) is read by a task
# that is specified but not yet built; it is listed so the deploy config is complete.

# --- The Graph ---------------------------------------------------------------
# Subgraph Studio API key, sent as a bearer token to gateway.thegraph.com. Read by
# packages/core/src/standardized/gateway.ts and scripts/verify-deployments.ts, which
# throws without it.
GRAPH_STUDIO_API_KEY=

# Substreams API token from thegraph.market. Not read by any TypeScript here; the
# substreams-sink-sql process needs it in its own environment to reach the endpoint.
SUBSTREAMS_API_TOKEN=

# --- Substreams sink database ------------------------------------------------
# Postgres holding vault_metrics / vault_latest / vault_meta plus the per-chain cursor
# tables (cursors_1, cursors_8453). Unset means the service has no ERC-4626 source and
# reports it unavailable. Neon works; any reachable Postgres does.
DATABASE_URL=

# --- Chain head RPC, for freshness -------------------------------------------
# Every source's age is measured against its chain's head block. An RPC failure marks
# every source on that chain stale rather than assuming it is current.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
# Any other chain in the standardized-deployments registry needs its own RPC_URL_<chainId>
# or its sources are always reported stale. Registry chains today: 42161, 10, 137.
# RPC_URL_42161=
# RPC_URL_10=
# RPC_URL_137=

# --- Service -----------------------------------------------------------------
PORT=8787
# Base URL the agent card advertises its own endpoints under. Must be the public URL
# in a deployment, or discovery hands clients unreachable links.
PUBLIC_URL=http://localhost:8787
# Required. Seeds for deterministic post-quantum key derivation at boot, so a redeploy
# keeps the same identity and old receipts stay verifiable. No key material is written
# to disk. Rotating either seed invalidates every previously issued receipt.
PQ_SIG_SEED=            # 32 bytes hex: openssl rand -hex 32
PQ_KEM_SEED=            # 64 bytes hex: openssl rand -hex 64
# Bearer token gating GET /v1/admin/metrics (spec §13.1). Unset disables the endpoint
# entirely (503 admin_disabled) rather than leaving it reachable with no credential.
# Also read by the dashboard's /admin server component (packages/dashboard).
ADMIN_TOKEN=

# --- Hedera testnet ----------------------------------------------------------
# Informational only: the service is hardcoded to testnet in packages/service/src/config.ts.
HEDERA_NETWORK=testnet
# Account that receives x402 payments. Must be associated with HEDERA_USDC_TOKEN.
HEDERA_PAYTO_ACCOUNT_ID=0.0.xxxxx
# Operator that submits HCS topic messages. Can be the same account as payTo.
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=            # ECDSA private key hex (DER or raw)
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_USDC_TOKEN=0.0.429274
# Written by scripts/identity.ts. Unset means no HCS commitments and /v1/receipts/:hash
# always answers with a null sequence.
HEDERA_HCS_TOPIC_ID=

# --- Arc testnet -------------------------------------------------------------
# Address that receives Circle Gateway settlements on Arc.
ARC_SELLER_ADDRESS=0x...
ARC_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# --- ERC-8004 identity (filled by scripts/identity.ts) -----------------------
# Agent ids in the IdentityRegistry at 0x8004A818BFB912233c491871b3d84c89A494BD9e.
# Each is published on the agent card so a client can read pq.sig.pubhash on chain and
# compare it with the card's own claim. Chain 296 is Hedera testnet, 5042002 is Arc.
ERC8004_HEDERA_AGENT_ID=
ERC8004_ARC_AGENT_ID=
# Identity bootstrap deployer keys (packages/service/scripts/identity.ts only; 0x-prefixed
# EVM private keys of ECDSA accounts with an EVM alias — not needed for --dry-run)
DEPLOYER_KEY_HEDERA=
DEPLOYER_KEY_ARC=

# --- Agent and demo clients --------------------------------------------------
# Service the agent, the demo script, and the dashboard talk to.
SERVICE_URL=http://localhost:8787
# Paying account on Hedera. Must be associated with the USDC token and hold HBAR for
# its own signature; the facilitator pays the network fee.
AGENT_HEDERA_ACCOUNT_ID=0.0.xxxxx
AGENT_HEDERA_KEY=               # ECDSA private key hex
# Paying key on Arc, with USDC deposited to Circle Gateway. Arc gas is USDC too. (designed)
AGENT_ARC_KEY=
# Model credentials for the Claude Agent SDK loop. (designed)
ANTHROPIC_API_KEY=
# Policy file the agent reads for budget, privacy tier, rail preference and
# max_age_seconds. (designed)
POLICY_PATH=packages/agent/policy.example.json
# One vault id, as "<chainId>:<0x address>", for the hello-x402 and hello-arc scripts.
VAULT=1:0x0000000000000000000000000000000000000000
# Set to a USDC amount to deposit into Gateway before paying, in hello-arc. (designed)
DEPOSIT=

# --- Dashboard ---------------------------------------------------------------
# Server components read SERVICE_URL above. The client-side receipt verifier at /verify
# needs the URL inlined at build time, so it reads this one instead.
NEXT_PUBLIC_SERVICE_URL=http://localhost:8787
# DEMO=1 makes the dashboard ignore the local runs/ directory and serve
# public/demo-run.json, which is what the hosted deployment uses.
DEMO=

# --- Tests and tooling -------------------------------------------------------
# LIVE=1 un-skips the live-testnet tests, which spend real testnet USDC.
LIVE=
# Chrome binary used by scripts/render-diagrams.mjs to render the mermaid diagrams.
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Device scale factor for those PNGs. 2 renders them at retina resolution.
# DIAGRAM_SCALE=1
